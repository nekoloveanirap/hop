-- =====================================================================
-- HTTP helper
-- =====================================================================
local REQUEST_HEADERS = {
    ["User-Agent"] = "Roblox/WinInet",
    ["Accept"] = "application/json",
}

local function tryRequesters(url)
    local attempts = {}
    if syn and syn.request then
        table.insert(attempts, {"syn.request", function()
            local res = syn.request({ Url = url, Method = "GET", Headers = REQUEST_HEADERS })
            return res.StatusCode, res.Body
        end})
    end
    if http and http.request then
        table.insert(attempts, {"http.request", function()
            local res = http.request({ Url = url, Method = "GET", Headers = REQUEST_HEADERS })
            return res.StatusCode, res.Body
        end})
    end
    if request then
        table.insert(attempts, {"request", function()
            local res = request({ Url = url, Method = "GET", Headers = REQUEST_HEADERS })
            return res.StatusCode, res.Body
        end})
    end
    table.insert(attempts, {"game:HttpGet", function()
        local body = game:HttpGet(url)
        return 200, body
    end})
    return attempts
end

local function httpGet(url)
    local attempts = tryRequesters(url)
    local lastErr = "no HTTP function available in this executor"

    for _, attempt in ipairs(attempts) do
        local name, fn = attempt[1], attempt[2]
        local ok, status, body = pcall(fn)
        if ok and body and body ~= "" then
            -- FIX: as vezes vem HTML de erro (ex: cloudflare/proxy) em vez de JSON.
            -- Filtra aqui pra nao mandar lixo pro JSONDecode.
            local trimmed = body:match("^%s*(.-)%s*$")
            if trimmed:sub(1, 1) == "{" or trimmed:sub(1, 1) == "[" then
                return body
            else
                lastErr = string.format("[%s] non-JSON response (likely error/HTML)", name)
            end
        elseif ok then
            lastErr = string.format("[%s] status=%s empty body", name, tostring(status))
        else
            lastErr = string.format("[%s] error: %s", name, tostring(status))
        end
        print("[ServerFinder] " .. lastErr)
    end
    return nil, lastErr
end

local function fetchServersFromHost(host, placeId)
    local servers = {}
    local cursor = ""
    local lastErr = nil

    for page = 1, PAGES_TO_SCAN do
        local url = "https://" .. host .. "/v1/games/" .. placeId ..
            "/servers/Public?sortOrder=Asc&excludeFullGames=false&limit=" .. SERVERS_PER_PAGE
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local body, err = httpGet(url)
        if not body then
            lastErr = "GET servers (" .. host .. ", page " .. page .. ") failed -> " .. tostring(err)
            break -- host inteiro sem resposta valida, desiste desse host
        end

        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
        if not ok or type(decoded) ~= "table" then
            -- FIX: pagina especifica com JSON ruim nao derruba tudo,
            -- so para de paginar esse host e fica com o que ja tem.
            lastErr = "Invalid JSON (" .. host .. ", page " .. page .. ")"
            break
        end

        if decoded.errors then
            local msg = decoded.errors[1] and decoded.errors[1].message or "unknown error"
            lastErr = "API (" .. host .. ") returned an error: " .. tostring(msg)
            break
        end

        if type(decoded.data) == "table" then
            for _, s in ipairs(decoded.data) do
                table.insert(servers, s)
            end
        end

        cursor = decoded.nextPageCursor
        if not cursor or cursor == "" then break end
    end

    return servers, lastErr
end

local function fetchServers(placeId)
    local lastErr = nil
    for _, host in ipairs(API_HOSTS) do
        local ok, servers, err = pcall(fetchServersFromHost, host, placeId)
        if ok and servers and #servers > 0 then
            return servers, nil
        end
        lastErr = (ok and err) or tostring(servers)
    end
    return {}, lastErr or "No API host responded."
end

-- FIX: agora garante MIN_LOW_PING servers com ping <= LOW_PING_THRESHOLD
-- no topo da lista (se existirem), e completa o resto ate TOP_N pelo
-- score de sempre (poucos players + ping bom).
local function getTopLowPopServers()
    local servers, sErr = fetchServers(PLACE_ID)
    if #servers == 0 then
        return nil, sErr or "The API returned no public servers (might be a network block in your executor)."
    end

    local function score(s)
        return (s.playing or 0) + ((s.ping or 250) / 10)
    end

    -- separa quem tem ping baixo
    local lowPing, rest = {}, {}
    for _, s in ipairs(servers) do
        if s.ping and s.ping <= LOW_PING_THRESHOLD then
            table.insert(lowPing, s)
        else
            table.insert(rest, s)
        end
    end

    table.sort(lowPing, function(a, b) return score(a) < score(b) end)
    table.sort(rest, function(a, b) return score(a) < score(b) end)

    local top, seen = {}, {}
    local function push(s)
        if not seen[s.id] and #top < TOP_N then
            seen[s.id] = true
            table.insert(top, s)
        end
    end

    -- prioridade total: todo mundo com ping <= 30ms entra primeiro, na ordem,
    -- so depois completa com o resto ate bater TOP_N
    for i = 1, #lowPing do push(lowPing[i]) end
    for i = 1, #rest do push(rest[i]) end

    return top, #lowPing
end

local function pingColor(ping)
    if not ping then return TEXT_DIM end
    if ping <= 120 then return GREEN end
    return RED
end


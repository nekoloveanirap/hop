-- =====================================================================
-- HTTP helper
-- =====================================================================
local REQUEST_HEADERS = {
    ["User-Agent"] = "Roblox/WinInet",
    ["Accept"] = "application/json",
}

local function tryRequesters(url)
    local attempts = {}

    if syn and syn.request then
        table.insert(attempts, {"syn.request", function()
            local res = syn.request({ Url = url, Method = "GET", Headers = REQUEST_HEADERS })
            return res.StatusCode, res.Body
        end})
    end
    if http and http.request then
        table.insert(attempts, {"http.request", function()
            local res = http.request({ Url = url, Method = "GET", Headers = REQUEST_HEADERS })
            return res.StatusCode, res.Body
        end})
    end
    if request then
        table.insert(attempts, {"request", function()
            local res = request({ Url = url, Method = "GET", Headers = REQUEST_HEADERS })
            return res.StatusCode, res.Body
        end})
    end
    table.insert(attempts, {"game:HttpGet", function()
        local body = game:HttpGet(url)
        return 200, body
    end})

    return attempts
end

local function httpGet(url)
    local attempts = tryRequesters(url)
    local lastErr = "nenhuma funcao de HTTP disponivel neste executor"

    for _, attempt in ipairs(attempts) do
        local name, fn = attempt[1], attempt[2]
        local ok, status, body = pcall(fn)
        if ok and body and body ~= "" then
            return body
        end
        if ok then
            lastErr = string.format("[%s] status=%s corpo vazio", name, tostring(status))
        else
            lastErr = string.format("[%s] erro: %s", name, tostring(status))
        end
        print("[ServerFinder] " .. lastErr)
    end
    return nil, lastErr
end

-- Busca servidores tentando cada host da lista até um funcionar
local function fetchServersFromHost(host, placeId)
    local servers = {}
    local cursor = ""
    local lastErr = nil

    for page = 1, PAGES_TO_SCAN do
        local url = "https://" .. host .. "/v1/games/" .. placeId ..
            "/servers/Public?sortOrder=Asc&excludeFullGames=false&limit=" .. SERVERS_PER_PAGE
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local body, err = httpGet(url)
        if not body then
            lastErr = "GET servers (" .. host .. ", pagina " .. page .. ") falhou -> " .. tostring(err)
            break
        end

        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
        if not ok or not decoded then
            lastErr = "JSON invalido (" .. host .. ", pagina " .. page .. "). Corpo: " .. tostring(body):sub(1, 150)
            break
        end

        if decoded.errors then
            local msg = decoded.errors[1] and decoded.errors[1].message or "erro desconhecido"
            lastErr = "API (" .. host .. ") respondeu com erro: " .. tostring(msg)
            break
        end

        for _, s in ipairs(decoded.data or {}) do
            table.insert(servers, s)
        end

        cursor = decoded.nextPageCursor
        if not cursor or cursor == "" then break end
    end

    return servers, lastErr
end

local function fetchServers(placeId)
    local lastErr = nil
    for _, host in ipairs(API_HOSTS) do
        local servers, err = fetchServersFromHost(host, placeId)
        if servers and #servers > 0 then
            return servers, nil
        end
        lastErr = err
    end
    return {}, lastErr or "Nenhum host de API respondeu."
end

-- Pontua servidor: prioriza poucos players, e usa o ping como
-- desempate pra dar mais estabilidade (menos players + bom ping).
local function getTopLowPopServers()
    local servers, sErr = fetchServers(PLACE_ID)
    if #servers == 0 then
        return nil, sErr or "A API nao retornou nenhum servidor publico (pode ser bloqueio de rede do executor)."
    end

    -- Ping pesa muito mais agora: cada 10ms de ping conta como 1 "jogador"
    -- na pontuação, entao um servidor com 30ms e 15 players pode ranquear
    -- melhor que um com 5 players mas 200ms.
    table.sort(servers, function(a, b)
        local aScore = (a.playing or 0) + ((a.ping or 250) / 10)
        local bScore = (b.playing or 0) + ((b.ping or 250) / 10)
        return aScore < bScore
    end)

    local top = {}
    for i = 1, math.min(TOP_N, #servers) do
        top[i] = servers[i]
    end
    return top
end

local function pingColor(ping)
    if not ping then return TEXT_DIM end
    if ping <= 120 then return GREEN end
    return RED
end


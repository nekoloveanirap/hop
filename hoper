local function addShadow(frame)
    -- Sem sombra: evita qualquer vazamento visual para fora da UI.
    return nil
end

local function addStroke(frame, thickness, transparency, color)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or STROKE
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0.6
    stroke.Parent = frame
    return stroke
end

local function addGradient(frame, colorSeq, rotation)
    local grad = Instance.new("UIGradient")
    grad.Color = colorSeq
    grad.Rotation = rotation or 90
    grad.Parent = frame
    return grad
end

local function popIn(frame)
    local target = frame.Size
    frame.Size = UDim2.new(target.X.Scale, target.X.Offset, 0, 0)
    frame.BackgroundTransparency = 1
    local tween = TweenService:Create(frame,
        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = target, BackgroundTransparency = 0 }
    )
    tween:Play()
end

local function hoverTween(guiObject, propTable, time)
    return TweenService:Create(guiObject, TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad), propTable)
end

local function makeDraggable(dragHandle, frame)
    local dragging, dragStart, startPos
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    dragHandle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end


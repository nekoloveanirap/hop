local function buildResults(servers, lowCount)
    clearList()
    selectedServer = nil
    selectedRow = nil
    rowBaseColors = {}
    updateHopButtonState()

    if not servers or #servers == 0 then
        statusLbl.Text = "No servers found."
        return
    end
    local lowMsg = ""
    if lowCount then
        if lowCount >= MIN_LOW_PING then
            lowMsg = " (" .. lowCount .. " under " .. LOW_PING_THRESHOLD .. "ms)"
        elseif lowCount > 0 then
            lowMsg = " (only " .. lowCount .. " under " .. LOW_PING_THRESHOLD .. "ms available)"
        else
            lowMsg = " (none under " .. LOW_PING_THRESHOLD .. "ms right now)"
        end
    end
    statusLbl.Text = "Top " .. #servers .. " servers" .. lowMsg .. " — select one"

    for i, s in ipairs(servers) do
        local baseColor = (i % 2 == 0) and BG_ROW_ALT or BG_ROW

        -- BUTTON: SERVIDOR
-- Texto do TextButton: "" (vazio)
-- O conteudo visual da linha mostra jogadores + ping.
-- Funcao: selecionar este servidor.
local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 34)
        row.BackgroundColor3 = baseColor
        row.AutoButtonColor = false
        row.Text = ""
        row.LayoutOrder = i
        row.ZIndex = 3
        row.Parent = listFrame
        rowBaseColors[row] = baseColor

        local rowCorner = Instance.new("UICorner")
        rowCorner.CornerRadius = UDim.new(0, 6)
        rowCorner.Parent = row

        -- CONTORNO DA LINHA: 1px, cinza neutro bem suave.
        local rowStroke = addStroke(row, 1, 0.60, Color3.fromRGB(180, 180, 180))
        rowStroke.Name = "RowStroke"

        local rankBadge = Instance.new("Frame")
        rankBadge.Name = "RankBadge"
        rankBadge.Size = UDim2.new(0, 22, 0, 22)
        rankBadge.Position = UDim2.new(0, 6, 0.5, -11)
        rankBadge.BackgroundColor3 = Color3.fromRGB(250, 216, 228)
        rankBadge.BorderSizePixel = 0
        rankBadge.ZIndex = 4
        rankBadge.Parent = row
        local rankCorner = Instance.new("UICorner")
        rankCorner.CornerRadius = UDim.new(1, 0)
        rankCorner.Parent = rankBadge
        addStroke(rankBadge, 1, 0.65, Color3.fromRGB(185, 185, 185))

        local rankLbl = Instance.new("TextLabel")
        rankLbl.Name = "RankLbl"
        rankLbl.BackgroundTransparency = 1
        rankLbl.Size = UDim2.new(1, 0, 1, 0)
        rankLbl.Font = Enum.Font.GothamBold
        rankLbl.TextSize = 12
        rankLbl.TextColor3 = ACCENT
        rankLbl.Text = tostring(i)
        rankLbl.ZIndex = 5
        rankLbl.Parent = rankBadge

        local playersLbl = Instance.new("TextLabel")
        playersLbl.BackgroundTransparency = 1
        playersLbl.Size = UDim2.new(0, 88, 1, 0)
        playersLbl.Position = UDim2.new(0, 36, 0, 0)
        playersLbl.Font = Enum.Font.GothamMedium
        playersLbl.TextSize = 13
        playersLbl.TextColor3 = TEXT
        playersLbl.TextXAlignment = Enum.TextXAlignment.Left
        playersLbl.Text = tostring(s.playing or "?") .. "/" .. tostring(s.maxPlayers or "?")
        playersLbl.ZIndex = 4
        playersLbl.Parent = row

        local pingDot = Instance.new("Frame")
        pingDot.Size = UDim2.new(0, 8, 0, 8)
        pingDot.Position = UDim2.new(0, 128, 0.5, -4)
        pingDot.BackgroundColor3 = pingColor(s.ping)
        pingDot.BorderSizePixel = 0
        pingDot.ZIndex = 4
        pingDot.Parent = row
        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = pingDot

        local pingLbl = Instance.new("TextLabel")
        pingLbl.BackgroundTransparency = 1
        pingLbl.Size = UDim2.new(0, 80, 1, 0)
        pingLbl.Position = UDim2.new(0, 142, 0, 0)
        pingLbl.Font = Enum.Font.GothamBold
        pingLbl.TextSize = 13
        pingLbl.TextColor3 = pingColor(s.ping)
        pingLbl.TextXAlignment = Enum.TextXAlignment.Left
        pingLbl.Text = (s.ping and (s.ping .. " ms")) or "N/D"
        pingLbl.ZIndex = 4
        pingLbl.Parent = row

        local joinHint = Instance.new("TextLabel")
        joinHint.Name = "JoinHint"
        joinHint.BackgroundTransparency = 1
        joinHint.Size = UDim2.new(0, 70, 1, 0)
        joinHint.Position = UDim2.new(1, -68, 0, 0)
        joinHint.Font = Enum.Font.GothamBold
        joinHint.TextSize = 11
        joinHint.TextColor3 = ACCENT
        joinHint.TextTransparency = 1
        joinHint.TextXAlignment = Enum.TextXAlignment.Right
        joinHint.Text = "SELECT"
        joinHint.ZIndex = 4
        joinHint.Parent = row

        row.MouseEnter:Connect(function()
            if selectedRow ~= row then
                hoverTween(row, { BackgroundColor3 = BG_ROW_HOVER }):Play()
                hoverTween(joinHint, { TextTransparency = 0 }):Play()
            end
        end)
        row.MouseLeave:Connect(function()
            if selectedRow ~= row then
                hoverTween(row, { BackgroundColor3 = baseColor }):Play()
                hoverTween(joinHint, { TextTransparency = 1 }):Play()
            end
        end)

        row.MouseButton1Click:Connect(function()
            -- desmarca a selecao anterior (volta tudo ao normal)
            if selectedRow and selectedRow.Parent then
                local prevBase = rowBaseColors[selectedRow]
                hoverTween(selectedRow, { BackgroundColor3 = prevBase }, 0.12):Play()
                local prevBadge = selectedRow:FindFirstChild("RankBadge")
                if prevBadge then
                    hoverTween(prevBadge, { BackgroundColor3 = Color3.fromRGB(250, 216, 228) }, 0.12):Play()
                    local prevRankLbl = prevBadge:FindFirstChild("RankLbl")
                    if prevRankLbl then prevRankLbl.TextColor3 = ACCENT end
                end
                local prevHint = selectedRow:FindFirstChild("JoinHint")
                if prevHint then
                    prevHint.Text = "SELECT"
                    prevHint.TextColor3 = ACCENT
                    hoverTween(prevHint, { TextTransparency = 1 }, 0.12):Play()
                end
                local prevStroke = selectedRow:FindFirstChild("SelectStroke")
                if prevStroke then prevStroke:Destroy() end
            end

            -- marca a nova selecao: preenchimento + badge + selo bem visiveis
            selectedServer = s
            selectedRow = row
            hoverTween(row, { BackgroundColor3 = Color3.fromRGB(232, 110, 148) }, 0.12):Play()
            hoverTween(rankBadge, { BackgroundColor3 = Color3.fromRGB(255, 238, 245) }, 0.12):Play()
            rankLbl.TextColor3 = TITLE_DEEP
            joinHint.Text = "SELECTED"
            joinHint.TextColor3 = ON_ACCENT
            joinHint.TextTransparency = 0
            local sel = addStroke(row, 1, 0.18, Color3.fromRGB(110, 110, 110))
            sel.Name = "SelectStroke"

            statusLbl.Text = "Selected server " .. i .. " — click Server Hop to join"
            updateHopButtonState()
        end)
    end
end

local isFetching = false

local function doRefresh()
    if isFetching then return end
    isFetching = true

    local wasHidden = not popupFrame.Visible
    popupFrame.Visible = true
    if wasHidden then
        popIn(popupFrame)
    end

    statusLbl.Text = "Searching servers..."
    clearList()
    hintLbl.Text = "Looking for the least crowded servers..."
    refreshBtn.Text = "Refreshing..."

    task.spawn(function()
        local ok, servers, lowCount = pcall(getTopLowPopServers)
        isFetching = false
        hintLbl.Text = ""
        refreshBtn.Text = "REFRESH"
        if not ok then
            statusLbl.Text = "Unexpected error: " .. tostring(servers)
            return
        end
        if not servers then
            statusLbl.Text = "Error: " .. tostring(lowCount)
            return
        end
        buildResults(servers, lowCount)
    end)
end

refreshBtn.MouseButton1Click:Connect(doRefresh)

local isFetching = false

local function doRefresh()
    if isFetching then return end
    isFetching = true

    local wasHidden = not popupFrame.Visible
    popupFrame.Visible = true
    if wasHidden then
        popIn(popupFrame)
    end

    statusLbl.Text = "Buscando servidores..."
    clearList()
    hintLbl.Text = "Procurando os servidores com menos jogadores..."
    refreshBtn.Text = "Refreshing..."

    task.spawn(function()
        local servers, err = getTopLowPopServers()
        isFetching = false
        hintLbl.Text = ""
        refreshBtn.Text = "Refresh"
        if not servers then
            statusLbl.Text = "Erro: " .. tostring(err)
            return
        end
        buildResults(servers)
    end)
end

refreshBtn.MouseButton1Click:Connect(doRefresh)

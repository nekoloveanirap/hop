    end)
    closeBtn.MouseLeave:Connect(function()
        hoverTween(closeBtn, { BackgroundTransparency = 1, TextColor3 = TEXT_DIM }):Play()
    end)
    closeBtn.MouseButton1Click:Connect(onClose)

